{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "object_id",
    "kind",
    "purpose"
  ],
  "properties": {
    "object_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "name": { "type": "string" },
    "controller": { "type": "string" },
    "representation": { "type": "string" },
    "authority": { "type": "string" },
    "states": { "type": "array" },
    "nonclaims": { "type": "array" }
  }
}
